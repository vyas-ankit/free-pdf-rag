{
  "default_provider": "openai",
  "providers": {
    "google": {
      "default_model": "gemini-flash-latest",
      "vision_model": "gemini-3.1-flash-lite",
      "api_key_env": "GOOGLE_API_KEY",
      "request_timeout": 120,
      "temperature": 0
    },
    "groq": {
      "default_model": "openai/gpt-oss-120b",
      "vision_model": "meta-llama/llama-4-scout-17b-16e-instruct",
      "api_key_env": "GROQ_API_KEY",
      "request_timeout": 120,
      "temperature": 0
    },
    "openai": {
      "default_model": "gpt-5.5",
      "vision_model": "gpt-4o",
      "api_key_env": "OPENAI_API_KEY",
      "request_timeout": 120,
      "temperature": 0
    }
  },
  "embeddings": {
    "provider": "huggingface",
    "model": "sentence-transformers/all-MiniLM-L6-v2"
  },
  "pinecone": {
    "index_name": "free-pdf-index",
    "dimension": 384,
    "metric": "cosine",
    "cloud": "aws",
    "region": "us-east-1",
    "upsert_batch_size": 100
  },
  "semantic_cache": {
    "score_threshold": 0.05
  },
  "image_descriptions": {
    "provider": "google",
    "model": null,
    "downscale": {
      "enabled": true,
      "max_dim": 768,
      "format": "PNG"
    },
    "min_interval_sec": 5
  },
  "retrieval": {
    "hybrid_search": {
      "enabled": true,
      "dense_weight": 0.65,
      "bm25": {
        "k1": 1.5,
        "b": 0.75
      }
    },
    "reranker": {
      "enabled": true,
      "model": "cross-encoder/ms-marco-MiniLM-L-6-v2"
    },
    "candidate_k": 50,
    "final_k": 15
  },
  "tool_calling": {
    "max_tool_call_rounds": 2,
    "query_expansion": {
      "enabled": true,
      "max_queries": 2
    }
  },
  "workflows": {
    "timeout_minutes": 30
  },
  "session_store": {
    "db_path": "data/sessions.db"
  },
  "ingestion": {
    "pdf_extraction": {
      "skip_top_pct": 0.03,
      "skip_bottom_pct": 0.95,
      "content_markers": ["Reading Time:", "What I Learned", "Introduction", "Overview"],
      "footer_markers": ["Share\n\nPrev", "Share", "Prev", "Next"],
      "image_context_words": 30
    },
    "chunking": {
      "max_words": 300
    }
  },
  "query_cache": {
    "enabled": false,
    "max_entries": 10,
    "similarity_threshold": 0.90,
    "cache_path": "data/cache/query_cache.json"
  },
  "guards": {
    "input": {
      "length": {
        "enabled": true,
        "max_tokens": 5000,
        "encoder": "cl100k_base"
      },
      "moderation": {
        "enabled": true,
        "model": "omni-moderation-latest",
        "max_tokens": 400,
        "thresholds": {
          "harassment":              0.5,
          "harassment/threatening":  0.5,
          "hate":                    0.5,
          "hate/threatening":        0.5,
          "illicit":                 0.5,
          "illicit/violent":         0.5,
          "self_harm":               0.4,
          "self_harm/intent":        0.3,
          "self_harm/instructions":  0.3,
          "sexual":                  0.5,
          "sexual/minors":           0.1,
          "violence":                0.7,
          "violence/graphic":        0.7
        }
      }
    }
  }
}
